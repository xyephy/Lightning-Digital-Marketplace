# Lightning Digital Marketplace - Environment Configuration
# Copy this file to .env and update with your settings

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here

# Polar Lightning Network Configuration
POLAR_API_URL=http://localhost:8080
POLAR_NETWORK=17
POLAR_ALICE_PORT=8081
POLAR_BOB_PORT=8082
POLAR_CAROL_PORT=8083

# Lightning Node Configuration (will be used in later stages)
LIGHTNING_BACKEND=polar
LIGHTNING_NETWORK=regtest

# Database Configuration (for later stages)
DATABASE_URL=sqlite:///marketplace.db

# Security Configuration (for production stages)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

